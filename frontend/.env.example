# Copia este archivo a .env.local (ignorado por git) para apuntar a un backend
# distinto del de producción durante el desarrollo.
#
# Emulador Android (AVD):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
#
# Dispositivo físico con Expo Go (usa la IP LAN de tu PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8080
EXPO_PUBLIC_API_URL=https://rastrix.deveps.dev
