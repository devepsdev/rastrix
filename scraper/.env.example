# Configuración del scraper. En la Orange Pi este fichero vive en
# /opt/apps/rastrix-scraper/.env con permisos 600 (solo lo lee su dueño).

# API de Rastrix y cuenta del bot (rol SCRAPER, asignado desde el panel).
RASTRIX_API_URL=https://rastrix.deveps.dev
RASTRIX_EMAIL=
RASTRIX_PASSWORD=

# DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Segundos de espera entre páginas, para no cargar los servidores ajenos.
REQUEST_DELAY_SECONDS=3
